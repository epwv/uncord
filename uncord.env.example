# copy to ~/.config/uncord/env (uncord makes it readable only by you)
# real environment variables win over this file, run `uncord --env` to see them all

# pick one way to give it your token, or leave all three out and use `uncord --login`
# UNCORD_TOKEN=
# UNCORD_TOKEN_CMD=pass show discord/token
# UNCORD_TOKEN_FILE=~/.config/uncord/token

# UNCORD_CONFIG_DIR=~/.config/uncord
# UNCORD_CACHE_DIR=~/.cache/uncord
# UNCORD_LOG_FILE=~/.cache/uncord/uncord.log
# UNCORD_LOG_LEVEL=info

# UNCORD_THEME=ansi-dark
# UNCORD_VAD=600
# UNCORD_NOTIFY=1
# UNCORD_NO_UPDATE_CHECK=0

# UNCORD_FFMPEG=/usr/bin/ffmpeg
# UNCORD_MPV=/usr/bin/mpv
# UNCORD_GSR=/usr/bin/gpu-screen-recorder
# UNCORD_OPUS=/usr/lib/libopus.so.0
# UNCORD_CHAFA=/usr/lib/libchafa.so.0
