pkgbase = uncord-git
	pkgdesc = Discord in your terminal, with voice calls, inline images and screen sharing
	pkgver = 0.75.13.r0.g0000000
	pkgrel = 1
	url = https://github.com/epwv/uncord
	arch = x86_64
	arch = aarch64
	license = MIT
	makedepends = git
	makedepends = python-pip
	makedepends = gcc
	depends = python
	depends = ffmpeg
	depends = opus
	depends = pipewire
	optdepends = chafa: faster, nicer inline images
	optdepends = mpv: pop videos and streams out into a window
	optdepends = wl-clipboard: paste images on wayland
	optdepends = xclip: paste images on x11
	optdepends = libnotify: desktop notifications
	optdepends = gpu-screen-recorder: share your screen
	provides = uncord
	conflicts = uncord
	options = !strip
	options = !debug
	source = uncord::git+https://github.com/epwv/uncord.git
	sha256sums = SKIP

pkgname = uncord-git
