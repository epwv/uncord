# Maintainer: owainxyz <281472559+owainxyz@users.noreply.github.com>
pkgname=uncord-git
_pkgname=uncord
pkgver=0.75.13.r0.g0000000
pkgrel=1
pkgdesc="Discord in your terminal, with voice calls, inline images and screen sharing"
arch=('x86_64' 'aarch64')
url="https://github.com/owainxyz/uncord"
license=('MIT')
depends=('python' 'ffmpeg' 'opus' 'pipewire')
makedepends=('git' 'python-pip' 'gcc')
optdepends=('chafa: faster, nicer inline images'
            'mpv: pop videos and streams out into a window'
            'wl-clipboard: paste images on wayland'
            'xclip: paste images on x11'
            'libnotify: desktop notifications'
            'gpu-screen-recorder: share your screen')
provides=('uncord')
conflicts=('uncord')
options=('!strip' '!debug')
source=("$_pkgname::git+$url.git")
sha256sums=('SKIP')

pkgver() {
    cd "$_pkgname"
    # base version comes from uncord/__init__.py, a trailing letter becomes a number (0.75f -> 0.75.6) like setup.py does
    local v l
    v=$(sed -n 's/^__version__ = "\(.*\)"/\1/p' uncord/__init__.py)
    case $v in *[a-z]) l=${v#"${v%?}"}; v=${v%?}.$(($(printf '%d' "'$l") - 96)) ;; esac
    printf "%s.r%s.g%s" "$v" "$(git rev-list --count HEAD)" "$(git rev-parse --short HEAD)"
}

package() {
    # python deps like discord.py-self master and davey aren't in the repos, so they live in a private venv
    local venv="/usr/lib/$_pkgname"
    python -m venv "$pkgdir$venv"
    "$pkgdir$venv/bin/python" -m pip install --no-cache-dir --disable-pip-version-check --quiet "$srcdir/$_pkgname"
    # the venv was built under $pkgdir, point its scripts at the real path
    grep -rlI --null "$pkgdir" "$pkgdir$venv/bin" "$pkgdir$venv/pyvenv.cfg" | xargs -0 -r sed -i "s|$pkgdir||g"
    rm -f "$pkgdir$venv"/lib/python*/site-packages/uncord-*.dist-info/direct_url.json
    find "$pkgdir$venv" -name '__pycache__' -prune -exec rm -rf {} +

    install -d "$pkgdir/usr/bin"
    printf '#!/bin/sh\nexec %s/bin/uncord "$@"\n' "$venv" > "$pkgdir/usr/bin/uncord"
    chmod 755 "$pkgdir/usr/bin/uncord"

    install -Dm644 "$srcdir/$_pkgname/packaging/uncord.desktop" "$pkgdir/usr/share/applications/uncord.desktop"
    install -Dm644 "$srcdir/$_pkgname/assets/icon.svg" "$pkgdir/usr/share/icons/hicolor/scalable/apps/uncord.svg"
    install -Dm644 "$srcdir/$_pkgname/README.md" "$pkgdir/usr/share/doc/$pkgname/README.md"
    install -Dm644 "$srcdir/$_pkgname/LICENSE" "$pkgdir/usr/share/licenses/$pkgname/LICENSE"
}
